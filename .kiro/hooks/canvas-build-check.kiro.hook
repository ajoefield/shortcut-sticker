{
  "enabled": true,
  "name": "Canvas Build Check",
  "description": "Runs vite build after editing canvas-related files (CreateLayout, designSystem, layoutStorage, SaveModal) to catch compile errors immediately",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/CreateLayout.jsx",
      "**/designSystem.js",
      "**/layoutStorage.js",
      "**/SaveModal.jsx",
      "**/exportCanvas.js"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd shortcut-sticker/frontend && npx vite build 2>&1 | tail -20",
    "timeout": 30
  },
  "workspaceFolderName": "Create Web Apps",
  "shortName": "canvas-build-check"
}